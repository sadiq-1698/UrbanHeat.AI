# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
POSTGRES_PASSWORD=changeme
# Only needed if 5432 is already taken on your machine (e.g. a local Postgres
# install) — uncomment and pick a free port, then update the two URLs below
# to match. docker-compose.yml defaults to 5432 if this isn't set.
# POSTGRES_HOST_PORT=5434
# Admin/write connection, used by db/migrate.sh and db/ingest/*
DATABASE_URL=postgresql://urbanheat_admin:changeme@localhost:5432/urbanheat
# Read-only connection (urbanheat_ro role), used ONLY by apps/web API routes
APP_DATABASE_URL=postgresql://urbanheat_ro:changeme_ro@localhost:5432/urbanheat
APP_RO_PASSWORD=changeme_ro

# --- Raster data (GeoTIFFs generated/ingested into data/rasters) ---
# Relative paths resolve against the repo root (apps/web/next.config.ts makes it absolute).
RASTER_DIR=./data/rasters

# --- ML model (ONNX + metadata produced by ml/) ---
MODEL_DIR=./ml/artifacts
